# ══════════════════════════════════════════════════════════════════════════════
#  .env.docker — runtime config for the containerised agent
#
#  Copy to .env.docker and fill in. NEVER commit the filled-in copy; on AWS
#  prefer Secrets Manager / SSM Parameter Store over shipping this file.
#
#      cp .env.docker.example .env.docker
# ══════════════════════════════════════════════════════════════════════════════

# ── GITHUB ────────────────────────────────────────────────────────────────────
GITHUB_USERNAME=sachinnishad98
GITHUB_TOKEN=

# ── SONARQUBE ─────────────────────────────────────────────────────────────────
# Service DNS name inside the container network — NOT localhost. Includes the
# /sonarqube web context the SonarQube image is configured with.
SONAR_URL=http://sonarqube:9000/sonarqube
# Generate after SonarQube's first boot:
#   docker compose exec sonarqube curl -u admin:<pwd> -X POST \
#     "http://localhost:9000/sonarqube/api/user_tokens/generate?name=agent"
SONAR_TOKEN=

# Path the agent proxies SonarQube under. Must match SONAR_WEB_CONTEXT in the
# SonarQube image, or its assets will 404.
SONAR_PROXY_PATH=/sonarqube

# ── CLAUDE AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── DATABASE (used by docker-compose for Postgres + SonarQube) ────────────────
POSTGRES_PASSWORD=

# ── SERVER ────────────────────────────────────────────────────────────────────
# 0.0.0.0 is required in a container; 127.0.0.1 would be unreachable from
# outside the network namespace.
HOST=0.0.0.0
PORT=3002
REPO_PATH=/repos

# ⚠️  Do NOT copy the Windows .env into the container. server.js also honours
# per-repo overrides named REPO_PATH_<reponame> (the dev machine has
# REPO_PATH_sonarqube-ai-agent-v1=D:\SonarQube\...). A drive-letter path does
# not exist inside a Linux container, and getRepoPath() returns it verbatim
# without validating it — the clone then fails with a confusing ENOENT.

# ── PUBLIC ORIGIN (set once behind an ALB / custom domain) ────────────────────
# Comma-separated. Needed so the socket.io CORS allowlist and the CSP
# connect-src accept the real browser origin — without it the live scan log
# silently stops updating in production.
# PUBLIC_ORIGIN=https://sonarai.example.com

# ── FIRST-BOOT ADMIN ──────────────────────────────────────────────────────────
# Without ADMIN_PASSWORD a random one is generated and printed to the container
# log exactly once — easy to lose. Set it explicitly for a container deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin User
ADMIN_EMAIL=

# ── EMAIL (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
