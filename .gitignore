# SECRETS — KABHI COMMIT MAT KARO
.env
.env.local
.env.production
.env.docker
*.env

# Docker env template is safe (no values) — keep it tracked
!.env.docker.example
.claude

# Auto-generated per-scan, contains live SONAR_TOKEN — never commit
sonar-project.properties
.scannerwork/

# Persisted AI review history (local runtime data, not source)
data/

# Node
node_modules/
npm-debug.log*

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Design QC screenshots — local artifacts, not source
.wolf/designqc-captures/
